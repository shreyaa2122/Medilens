# ---------- Database ----------
# Default: SQLite, a single file. Nothing to install, uses almost no disk space.
DATABASE_URL=sqlite:///./data/medilens.db
# To use PostgreSQL instead (e.g. for deployment), start it with:
#   docker compose --profile postgres up
# and use:
# DATABASE_URL=postgresql+psycopg://medilens:change_me_locally@db:5432/medilens
POSTGRES_USER=medilens
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=medilens

# ---------- Backend ----------
ENVIRONMENT=development
LOG_LEVEL=INFO
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
# Comma-separated list of browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173
# If a PDF has fewer characters than this, it is treated as a scan and sent to OCR
OCR_MIN_NATIVE_TEXT_CHARS=100

# ---------- AI provider (all options are free) ----------
# none   = rule-based extraction only. No downloads, no account. (default)
# gemini = Google Gemini free tier. No disk space needed, but extracted text is
#          sent to Google. Free key: aistudio.google.com
# ollama = runs a model on your own machine. Private, but needs 2 GB+ of disk space.
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_MAX_UPLOAD_MB=10
